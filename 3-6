fun main() {
    var soma = 0.0
    var contador = 1

    while (contador <= 6) {
        println("Digite a nota $contador:")
        val nota = readLine()!!.toDouble()

        if (nota >= 0 && nota <= 10) {
            soma = soma + nota
            contador = contador + 1
        } else {
            println("Nota inválida. Digite uma nota de 0 a 10.")
        }
    }

    val media = soma / 6

    println("Soma das notas: $soma")
    println("Média: $media")
}
